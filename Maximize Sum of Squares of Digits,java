class Solution {
    public String maxSumOfSquares(int num, int sum) {
        // If the sum is strictly greater than the maximum possible sum (all 9s), it's impossible.
        if (sum > 9L * num) {
            return "";
        }
        
        int nines = sum / 9;
        int rem = sum % 9;
        int zeros = num - nines - (rem > 0 ? 1 : 0);
        
        StringBuilder sb = new StringBuilder(num);
        
        // 1. Append as many 9s as possible
        for (int i = 0; i < nines; i++) {
            sb.append('9');
        }
        
        // 2. Append the remainder if it exists
        if (rem > 0) {
            sb.append(rem);
        }
        
        // 3. Pad the rest of the string with 0s to reach exactly `num` length
        for (int i = 0; i < zeros; i++) {
            sb.append('0');
        }
        
        return sb.toString();
    }
}
